# ==============================================================================
# Antioch Syrian University (ASU) - Frontend Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust the URLs according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Base URL
# ------------------------------------------------------------------------------
# URL of the Django REST Framework backend API
# Localhost development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production on Vercel or cloud server:
# NEXT_PUBLIC_API_URL=https://your-backend-domain.vercel.app


# ------------------------------------------------------------------------------
# 2. Frontend Public Site URL (Optional / SEO / Canonical)
# ------------------------------------------------------------------------------
# Public URL where the frontend application is hosted
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://asu-front-end.vercel.app
